# Copy to .env at the repository root if you want to override defaults.
# Local `pnpm dev` works without this file.

# API
PORT=3001
TABLE_NAME=Players
# Leave unset to start an in-process DynamoDB (dynalite) on port 8000.
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000
PRICE_PROVIDER=coinbase
COINBASE_TICKER_URL=https://api.exchange.coinbase.com/products/BTC-USD/ticker
# CoinGecko is rate-limited from Cloudflare. MEXC's public trade is BTC/USDT, not BTC/USD.
# PRICE_PROVIDER=coingecko
# PRICE_PROVIDER=mexc
QUOTE_MAX_AGE_MS=15000
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development

# Web production build. Leave empty in local dev so Vite proxies /api.
# VITE_API_URL=https://epilot-btc-arena-api.btc-arena-demo-2026.workers.dev
